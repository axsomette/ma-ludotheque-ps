# Copier en .env.local pour le développement local (jamais commité).
# Sans ces deux valeurs, l'appli démarre en « mode démo » (données dans le navigateur).
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...   # clé publique « publishable » (ou ancienne clé anon)
# Clé du site Cloudflare Turnstile, si le CAPTCHA est activé dans Supabase (clé de test qui passe toujours : 1x00000000000000000000AA)
VITE_TURNSTILE_SITE_KEY=
